/// Annual youth unemployment rates from ILO Table A.1.
table Rates
	lineageTag: 268edf34-f9de-4a38-a392-a55f0eee0279

	/// 2025 Total youth unemployment rate for exactly one geography. Year and Sex filters are overridden. Undefined multi-geography totals and no-matching-geography contexts return blank; rates are not additive.
	measure 'Youth Unemployment Rate 2025' =
			VAR _hasOneRegion =
			    CALCULATE (
			        HASONEVALUE ( 'Rates'[Region] ),
			        REMOVEFILTERS ( 'Rates'[Year], 'Rates'[Sex] )
			    )
			RETURN
			    IF (
			        _hasOneRegion,
			        CALCULATE (
			            SELECTEDVALUE ( 'Rates'[YouthUnemploymentRate] ),
			            'Rates'[Year] = 2025,
			            'Rates'[Sex] = "Total"
			        ),
			        BLANK ()
			    )
		formatString: 0.0%
		displayFolder: Headline metrics
		lineageTag: f5ab51e1-cfc1-4555-8ff0-b01ba3d9b151

	/// Fixed World 2025 Total rate for ages 15-24, independent of regional or other report selections. Source aggregate, not a sum or average of subregions.
	measure 'World Youth Unemployment Rate 2025' =
			CALCULATE (
			    SELECTEDVALUE ( 'Rates'[YouthUnemploymentRate] ),
			    REMOVEFILTERS ( 'Rates' ),
			    'Rates'[Region] = "World",
			    'Rates'[Year] = 2025,
			    'Rates'[Sex] = "Total",
			    'Rates'[AgeGroup] = "15-24"
			)
		formatString: 0.0%
		displayFolder: Headline metrics
		lineageTag: e0038f90-a774-44e9-b96f-8168ae449db9

	/// Fixed approximate World 2025 unemployed youth count in millions, ages 15-24. The stored 67M is a rounded ILO headline, not an exact individual count. Missing source counts remain blank.
	measure 'Unemployed Youth 2025' =
			VAR _worldCount =
			    CALCULATE (
			        SELECTEDVALUE ( 'Rates'[UnemployedPeople] ),
			        REMOVEFILTERS ( 'Rates' ),
			        'Rates'[Region] = "World",
			        'Rates'[Year] = 2025,
			        'Rates'[Sex] = "Total",
			        'Rates'[AgeGroup] = "15-24"
			    )
			RETURN
			    DIVIDE ( _worldCount, 1000000 )
		formatString: """≈ ""0""M"""
		displayFolder: Headline metrics
		lineageTag: d97d7255-61b7-42fe-850f-a3ac793cbbb4

	column Region
		dataType: string
		lineageTag: 765007ba-2ee8-4d72-9171-cf5a58fa07e9
		summarizeBy: none
