		annotation SummarizationSetBy = Automatic

	column EstimateStatus
		dataType: string
		lineageTag: 7dfba1b6-f2c7-49c6-9e9c-5cb916f5ad7e
		summarizeBy: none
		sourceColumn: EstimateStatus

		annotation SummarizationSetBy = Automatic

	/// Reviewed local Excel source; DataFilePath must be configured in the private copy before refresh.
	partition Rates = m
		mode: import
		source =
				let
					ConfiguredPath = if Text.Trim(DataFilePath) = "" then error Error.Record("DataFilePathNotConfigured", "Set the DataFilePath text parameter to the absolute path of the reviewed excel/youth-unemployment.xlsx before refreshing. See README local setup.", null) else DataFilePath,
					Source = Excel.Workbook(File.Contents(ConfiguredPath), null, true),
					RatesTable = Source{[Item = "YouthRates", Kind = "Table"]}[Data],
					Typed = Table.TransformColumnTypes(
						RatesTable,
						{
							{"Region", type text},
							{"RegionType", type text},
							{"Year", Int64.Type},
							{"AgeGroup", type text},
							{"Sex", type text},
							{"YouthUnemploymentRate", type number},
							{"UnemployedPeople", Int64.Type},
							{"EstimateStatus", type text}
						}
					)
				in
					Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
