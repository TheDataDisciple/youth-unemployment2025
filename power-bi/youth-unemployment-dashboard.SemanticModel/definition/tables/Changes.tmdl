/// ILO-reported percentage-point changes between 2023 and 2025 from Figure 1.3.
table Changes
	lineageTag: a6b337cf-3728-4ea8-8bca-b8ce8771c28b

	/// ILO Figure 1.3 Total-sex reported percentage-point change for one geography, fixed 2023-2025. Sex and period filters are overridden. Multi-geography totals/no match return blank. Printed zeros are rounded, not exact stability.
	measure 'Reported Change 2023-2025' =
			VAR _hasOneRegion =
			    CALCULATE (
			        HASONEVALUE ( 'Changes'[Region] ),
			        REMOVEFILTERS ( 'Changes'[Sex], 'Changes'[StartYear], 'Changes'[EndYear] )
			    )
			RETURN
			    IF (
			        _hasOneRegion,
			        CALCULATE (
			            SELECTEDVALUE ( 'Changes'[ReportedChangePP] ),
			            'Changes'[Sex] = "Total",
			            'Changes'[StartYear] = 2023,
			            'Changes'[EndYear] = 2025
			        ),
			        BLANK ()
			    )
		formatString: +0.0 "pp";-0.0 "pp";0.0 "pp"
		displayFolder: Headline metrics
		lineageTag: 248ab6c5-791c-4c21-aa11-f19ac232a1ff

	/// Fixed unweighted whole-scope count of 8 of 11 ILO subregions: six positive reported Total changes plus two rounded zeros, 2023-2025. World is excluded. Independent of regional selections; no significance or exact-zero claim.
	measure 'Stalled or Worsened Subregions' =
			CALCULATE (
			    DISTINCTCOUNT ( 'Changes'[Region] ),
			    REMOVEFILTERS ( 'Changes' ),
			    'Changes'[RegionType] = "Subregion",
			    'Changes'[Sex] = "Total",
			    'Changes'[StartYear] = 2023,
			    'Changes'[EndYear] = 2025,
			    'Changes'[ReportedChangePP] >= 0
			)
		formatString: 0" of 11"
		displayFolder: Headline metrics
		lineageTag: f51d8999-50a1-42d3-98d3-0db68e0473d4

	column Region
		dataType: string
		lineageTag: 8186a858-dc60-4eac-8d6a-4cf9e5ce67f0
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = Automatic

	column RegionType
		dataType: string
		lineageTag: 1ef200f4-ae92-4d60-bf0b-8fbd48cf8c7d
		summarizeBy: none
