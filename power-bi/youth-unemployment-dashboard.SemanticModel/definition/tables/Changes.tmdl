		summarizeBy: none
		sourceColumn: StartYear

		annotation SummarizationSetBy = Automatic

	column EndYear
		dataType: int64
		formatString: 0
		lineageTag: daccaf2c-b29a-44fc-ab85-2344ba1fc3bc
		summarizeBy: none
		sourceColumn: EndYear

		annotation SummarizationSetBy = Automatic

	column AgeGroup
		dataType: string
		lineageTag: 2e09a5be-2b49-4551-9318-6d0762a9acb8
		summarizeBy: none
