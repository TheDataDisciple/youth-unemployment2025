	column ReportedChangePP
		dataType: double
		formatString: +0.0;-0.0;0.0
		lineageTag: 51b0cad5-cf2e-4414-b4cf-9d84479b872f
		summarizeBy: none
		sourceColumn: ReportedChangePP

		annotation SummarizationSetBy = Automatic

	column Direction
		dataType: string
		lineageTag: 473c9225-24da-4c09-8578-6b5c70bcd386
		summarizeBy: none
		sourceColumn: Direction

		annotation SummarizationSetBy = Automatic

	/// Reviewed local Excel source; DataFilePath must be configured in the private copy before refresh.
	partition Changes = m
		mode: import
		source =
				let
					ConfiguredPath = if Text.Trim(DataFilePath) = "" then error Error.Record("DataFilePathNotConfigured", "Set the DataFilePath text parameter to the absolute path of the reviewed excel/youth-unemployment.xlsx before refreshing. See README local setup.", null) else DataFilePath,
					Source = Excel.Workbook(File.Contents(ConfiguredPath), null, true),
					ChangeTable = Source{[Item = "ReportedChanges", Kind = "Table"]}[Data],
					Typed = Table.TransformColumnTypes(
						ChangeTable,
						{
							{"Region", type text},
							{"RegionType", type text},
							{"StartYear", Int64.Type},
							{"EndYear", Int64.Type},
							{"AgeGroup", type text},
							{"Sex", type text},
							{"ReportedChangePP", type number},
							{"Direction", type text}
						}
					)
				in
					Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
